---
import Base from "../../layouts/Base.astro";
import feeds from "../../data/feeds.json";
import { withBase } from "../../lib/url";
---

<Base title="About this site" description="Curation NPB — site policy and data sources.">
  <section class="container-page" style="max-width:720px; padding:56px 24px 80px;">
    <h1 class="font-display font-black m-0" style="font-size:28px; color:var(--text); margin-bottom:20px;">About this site</h1>

    <div class="space-y-8" style="font-size:15px; line-height:1.9; color:var(--text-muted);">
      <div>
        <h2 class="font-bold m-0" style="font-size:16px; color:var(--text); margin-bottom:8px;">Our idea</h2>
        <p class="m-0">
          Curation NPB brings news for all 12 Nippon Professional Baseball teams together in one ad-free place.
          Our aim is a focused reading experience without banner ads or tracking scripts.
        </p>
      </div>

      <div>
        <h2 class="font-bold m-0" style="font-size:16px; color:var(--text); margin-bottom:8px;">How news is collected</h2>
        <p class="m-0">
          Only headlines and summaries are collected from the baseball news RSS feeds listed below.
          Items are classified automatically using team names and other keywords. Full articles are not copied.
          Select an item to read the original article on its publisher website.
        </p>
        <ul style="margin-top:12px; padding-left:20px; list-style:disc;">
          {feeds.map((feed) => (
            <li>{feed.name}</li>
          ))}
        </ul>
        <p style="margin-top:12px;">
          Scheduled GitHub Actions runs update the news. Automatic classification may occasionally assign an item to the wrong team.
        </p>
      </div>

      <div>
        <h2 class="font-bold m-0" style="font-size:16px; color:var(--text); margin-bottom:8px;">Copyright</h2>
        <p class="m-0">
          Copyright in each article belongs to its publisher. This site is a collection of headlines, summaries and links;
          it does not reproduce full articles. For questions about an article,
          please contact its publisher.
        </p>
      </div>

      <div>
        <h2 class="font-bold m-0" style="font-size:16px; color:var(--text); margin-bottom:8px;">Site policy</h2>
        <p class="m-0">
          This is an independent, noncommercial project without advertising, affiliate links or analytics tracking.
        </p>
      </div>

      <div>
        <h2 class="font-bold m-0" style="font-size:16px; color:var(--text); margin-bottom:8px;">Features</h2>
        <ul style="padding-left:20px; list-style:disc;">
          <li><strong>Search news</strong> — Search news by title, summary or team name (<a class="link-underline" style="color:var(--accent);" href={withBase("/search/")}>Search page</a>).</li>
          <li><strong>My team</strong> — Choose ★ My team in the header to show its news on the home page. Your choice stays on this device and is not sent to a server.</li>
          <li><strong>Browse topics</strong> — Browse news across teams by trades, injuries, contracts and other topics (<a class="link-underline" style="color:var(--accent);" href={withBase("/topic/")}>Topic directory</a>).</li>
          <li><strong>Grouped coverage</strong> — Reports on the same event are grouped with their sources listed together.</li>
          <li><strong>Add to home screen</strong> — Use Add to Home Screen in your mobile browser for app-like access. Recently viewed content can be available offline.</li>
        </ul>
      </div>
    </div>
  </section>
</Base>
